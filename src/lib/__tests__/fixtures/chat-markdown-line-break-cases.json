{
  "_comment": "Kit parseChatMarkdownBlocks와 안드로이드 :kit ChatMarkdown.kt의 줄 경계 계약(E43 iOS 확인 후보 ③). 위원장 판정 2026-09-27로 웹 react-markdown(CommonMark) 쪽에 맞췄다 — CRLF는 줄 경계 하나라 헤딩·목록이 갈라지고, 단락 안에서는 \\n으로 이어지며 \\r은 남지 않는다. CR 단독·VT·FF·NEL은 Kit·:kit 모두 줄 경계로 쓰지 않는다(웹 CommonMark는 CR 단독도 줄 끝이다 — 남은 차이). kind: heading·listItem·paragraph.",
  "cases": [
    { "name": "crlf-heading-first", "input": "## 제목\r\n본문", "expect": [{ "kind": "heading", "text": "제목" }, { "kind": "paragraph", "text": "본문" }] },
    { "name": "crlf-heading", "input": "본문\r\n## 제목", "expect": [{ "kind": "paragraph", "text": "본문" }, { "kind": "heading", "text": "제목" }] },
    { "name": "crlf-list", "input": "- 하나\r\n- 둘", "expect": [{ "kind": "listItem", "text": "• 하나" }, { "kind": "listItem", "text": "• 둘" }] },
    { "name": "crlf-blank-line", "input": "가\r\n\r\n나", "expect": [{ "kind": "paragraph", "text": "가" }, { "kind": "paragraph", "text": "나" }] },
    { "name": "crlf-paragraph-join", "input": "가\r\n나", "expect": [{ "kind": "paragraph", "text": "가\n나" }] },
    { "name": "cr-alone", "input": "가\r\r나", "expect": [{ "kind": "paragraph", "text": "가\r\r나" }] },
    { "name": "vt", "input": "가\u000B나", "expect": [{ "kind": "paragraph", "text": "가\u000B나" }] },
    { "name": "ff", "input": "가\u000C나", "expect": [{ "kind": "paragraph", "text": "가\u000C나" }] },
    { "name": "nel", "input": "## 제목\u0085본문", "expect": [{ "kind": "paragraph", "text": "## 제목\u0085본문" }] },
    { "name": "nel-line-not-blank", "input": "가\n\u0085\n나", "expect": [{ "kind": "paragraph", "text": "가\n\u0085\n나" }] },
    { "name": "lf-control", "input": "본문\n## 제목\n- 하나", "expect": [{ "kind": "paragraph", "text": "본문" }, { "kind": "heading", "text": "제목" }, { "kind": "listItem", "text": "• 하나" }] }
  ]
}
