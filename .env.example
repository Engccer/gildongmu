# 길동무 환경변수 예시
#
# 이 파일을 `.env.local`로 복사한 뒤 필요한 키만 채운다.
# **키가 없는 기능은 오류가 아니라 조용히 빠진다**(도구·섹션·버튼이 전부 노출되지 않는다).
# 그래서 키를 빠뜨리면 "그 기능이 없는 앱"이 되고 오류로는 드러나지 않는다 — 특정 기능이
# 안 보이면 먼저 이 파일부터 확인할 것.
#
# 키 발급 경로·쿼터·만료는 `CLAUDE.md` "API 키 현황" 표가 정본이다.
# 전부 서버 전용이다(`NEXT_PUBLIC_` 접두 없는 것은 클라이언트로 나가지 않는다).

# ── 카카오 REST API (developers.kakao.com) ──────────────────────────
# 장소 검색 + 지오코딩 + 도보 경로 + 자동차 경로 폴백을 이 키 하나가 담당한다.
# dodo-planet 카카오 앱의 REST API 키를 공유한다.
# ⚠ 카카오 디벨로퍼스 > 내 애플리케이션 > 카카오맵 서비스 활성화 필요(비활성 시 401).
KAKAO_REST_API_KEY=

# ── 공공데이터포털 data.go.kr ───────────────────────────────────────
# 계정당 단일 키다. 아래 둘은 **같은 값**을 넣는다(역사적 이유로 이름이 둘).
# 코레일 역시설·TAGO 버스/지하철·소아진료·공기질·날씨·무장애 관광정보가 공유한다.
# 신규 API는 활용신청만 하면 즉시 자동승인(전파 5~30분).
# ⚠ 신규 provider 인증은 반드시 DATA_GO_KR_API_KEY로 — TOUR_API_KEY로 인증하면
#    게이트 함수와 split-brain이 되어 거짓 "정보 없음"이 낭독된다.
DATA_GO_KR_API_KEY=
TOUR_API_KEY=

# ── 행정안전부 도로명주소 (juso.go.kr) ──────────────────────────────
# 주소·우편번호 검색과 영문주소. 무료·무제한.
JUSO_CONFM_KEY=

# ── 서울 열린데이터광장 (openapi.seoul.go.kr) ───────────────────────
# 따릉이·문화행사·실시간 혼잡도·엘리베이터가 **일 1,000회를 공유**한다.
SEOUL_OPEN_DATA_KEY=

# ── 서울 지하철 실시간 도착 (swopenapi.seoul.go.kr) ─────────────────
# ⚠ 위 열린데이터 키와 **다른 키**다("실시간 데이터 인증키").
#    일반 키로 호출하면 ERROR-338. 일 1,000회.
SEOUL_SUBWAY_REALTIME_KEY=

# ── ODsay 대중교통 길찾기 (lab.odsay.com) ───────────────────────────
# ⚠ URI(도메인) 전용 앱 키여야 한다. Server 앱 키는 referer 식별이 안 된다.
# ⚠ 키에 `+`·`/`가 들어가므로 **URL 인코딩된 형태 그대로** 저장한다.
ODSAY_API_KEY=

# ── Tmap (SK open API) ──────────────────────────────────────────────
# 자동차 경로 기본(ko) + 도보 경로 폴백. 일 1,000건을 둘이 공유한다.
# ⚠ IPS는 "Any IP allowed" 유지(Vercel egress IP가 가변이라 제한하면 죽는다).
TMAP_APP_KEY=

# ── NAVER Cloud Platform Maps ───────────────────────────────────────
# en 로케일의 영문주소 보강 폴백 + en 자동차 경로.
# REST 헤더: x-ncp-apigw-api-key-id / x-ncp-apigw-api-key
NCP_MAPS_CLIENT_ID=
NCP_MAPS_CLIENT_SECRET=

# ── 네이버 지역검색 (developers.naver.com) ──────────────────────────
# ko 장소 검색을 카카오 결과에 보강 병합한다. 일 25,000회·결과 최대 5건.
# ⚠ 2027-06-30까지 NAVER API Hub(NCP 키)로 이관해야 한다.
NAVER_LOCAL_CLIENT_ID=
NAVER_LOCAL_CLIENT_SECRET=

# ── Gemini (채팅 엔진) ──────────────────────────────────────────────
# function calling 기반 채팅. 없으면 채팅 진입점 자체가 노출되지 않는다.
# ⚠ 길동무 전용 GCP 프로젝트의 API 제한 키를 쓴다(dodo와 공유 금지 — 사용량 귀속 불가).
GEMINI_API_KEY=
# ⚠ 모델명은 env가 아니라 코드 상수다(`src/lib/gemini/client.ts`의 `GEMINI_MODEL`).
#    교체 시 scripts/usage-report.mjs의 단가 기준 상수도 함께 갱신한다(drift 테스트가 강제).

# ── Perplexity (웹 검색) ────────────────────────────────────────────
# 검색창 웹 섹션(장소·주소 0건일 때 폴백) + 채팅 search_web 도구. 유료.
PERPLEXITY_API_KEY=

# ── Deepgram (웹 음성 받아쓰기) ─────────────────────────────────────
# 웹 STT. iOS는 온디바이스라 이 키를 쓰지 않는다.
# ⚠ prod에서 502가 나면 코드보다 키 유효성을 먼저 의심할 것(401이 502로 보인다).
DEEPGRAM_API_KEY=

# ── Google Cloud TTS (iOS 답변 듣기 폴백) ───────────────────────────
# 정본은 iOS 온디바이스 AVSpeechSynthesizer이고, 이 키는 현재 로케일 보이스가
# 기기에 없을 때만 쓰이는 폴백이다(지원 6개 로케일에선 사실상 미도달).
GOOGLE_CLOUD_TTS_API_KEY=

# ── 개발용 옵션 ─────────────────────────────────────────────────────
# 장소 검색 provider 강제 지정(A/B 비교용). 생략 시 자동 선택.
# ⚠ mock은 개발 편의용이고 장소 검색에만 있다 — 다른 도메인은 키가 없으면 노출되지 않는다.
# PLACES_PROVIDER=kakao | naver | tour | mock

# ── 클라이언트 노출 변수 ────────────────────────────────────────────
# nmap:// 딥링크의 appname(앱·서비스 식별자)
NEXT_PUBLIC_APP_IDENTIFIER=space.dodoplanet.gildongmu
