<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 둘 다 선언해야 Android 12의 "정확한/대략적인" 선택 다이얼로그가 정상 동작한다. 백그라운드 위치는 요청하지 않는다(D11). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- ⚠ 도보 실시간 안내(실험판 봉인)의 전경 서비스(location)·FOREGROUND_SERVICE(_LOCATION)·WAKE_LOCK·ACTIVITY_RECOGNITION은 `src/experimental/AndroidManifest.xml`에만 있다
         (iOS `Info-Experimental.plist`·백그라운드 모드 미러). 정식 APK에 없음을 `AppSourceGuardTest`·`android/scripts/check-release-manifest.mjs`가 잠근다. 졸업 때 여기로 승격한다. -->
    <!-- 지속 알림(상태 한 줄 + 안내 종료 액션). 거부해도 서비스는 돈다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 톤 동기 진동·결과 진동 3종. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".GildongmuApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
