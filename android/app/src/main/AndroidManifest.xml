<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 둘 다 선언해야 Android 12의 "정확한/대략적인" 선택 다이얼로그가 정상 동작한다. 백그라운드 위치는 요청하지 않는다(D11). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- M4 도보 실시간 안내(spec 2026-09-16-android-m4 §3-4). 전경 서비스(location 타입)가 안내 세션 동안 위치 스트림을 연다(D11). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 지속 알림(상태 한 줄 + 안내 종료 액션). 거부해도 서비스는 돈다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 톤 동기 진동·결과 진동 3종. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 서비스 수명 부분 wake lock — 화면 꺼짐 + fix 두절에서 워치독(8초 톤·15초 음성·도착 추정·잊힌 세션)이 절전과 함께 멎지 않게. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 종료 화면 걸음·칼로리 요약(TYPE_STEP_COUNTER). 거부면 요약만 없다. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <application
        android:name=".GildongmuApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 도보 실시간 안내 전경 서비스(M4 §4-1). 전경에서만 시작되며 시작 실패는 서비스 안에서 잡아 모델로 되부른다. -->
        <service
            android:name=".guide.GuideForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
