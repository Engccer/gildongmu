        }
      }
    },
    "whereAmI.geoDenied": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치 권한이 필요합니다. 브라우저에서 위치 접근을 허용해 주세요."
