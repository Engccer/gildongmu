    "route.briefing.button": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동차 경로 안내"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview car route as text"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchar la ruta en coche como texto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu de l'itinéraire en voiture en texte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima testuale del percorso in auto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "車の経路案内"
          }
        }
      }
    },
    "route.briefing.disclaimer": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 교통 기준 예상치입니다. 실제 주행 안내는 지도 앱 길찾기를 이용하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates based on live traffic. For turn-by-turn driving, use a map app via the directions links."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimaciones basadas en el tráfico en tiempo real. Para indicaciones paso a paso, usa una app de mapas mediante los enlaces de cómo llegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimations basées sur le trafic en temps réel. Pour une navigation détaillée, utilisez une application de carte via les liens d'itinéraire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stime basate sul traffico in tempo reale. Per le indicazioni svolta per svolta, usa un'app di mappe tramite i link alle indicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアルタイム交通に基づく推定です。実際の走行案内は地図アプリの経路検索をご利用ください。"
          }
        }
      }
    },
    "route.briefing.error": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로 브리핑에 실패했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Route briefing failed. Please try again shortly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resumen de la ruta falló. Inténtalo de nuevo en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la présentation de l'itinéraire. Veuillez réessayer dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riepilogo del percorso non riuscito. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経路案内に失敗しました。しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "route.briefing.geoError": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치를 가져올 수 없습니다. 브라우저의 위치 권한을 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not get your location. Please check the browser's location permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener tu ubicación. Revisa el permiso de ubicación del navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'obtenir votre position. Veuillez vérifier l'autorisation de localisation du navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile ottenere la tua posizione. Controlla le autorizzazioni di localizzazione del browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地を取得できません。ブラウザの位置情報の許可をご確認ください。"
          }
        }
      }
    },
    "route.briefing.heading": {
