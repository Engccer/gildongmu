    "whereAmI.error": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치 조회에 실패했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to look up your location. Please try again shortly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo consultar tu ubicación. Inténtalo de nuevo en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la localisation. Veuillez réessayer dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile localizzarti. Riprova tra poco."
          }
        },
