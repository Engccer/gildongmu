    "bike.error": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따릉이 정보 조회에 실패했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load bike information. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la información de bicicletas. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les informations sur les vélos. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare le informazioni sulle bici. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タルンイ情報の照会に失敗しました。しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "bike.geoDenied": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치 권한이 필요합니다. 브라우저에서 위치 접근을 허용해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission is required. Please allow location access in your browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso de ubicación. Permite el acceso a la ubicación en tu navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation de localisation est requise. Veuillez autoriser l'accès à la position dans votre navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessaria l'autorizzazione alla localizzazione. Consenti l'accesso alla posizione nel browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報の許可が必要です。ブラウザで位置情報へのアクセスを許可してください。"
          }
        }
      }
    },
