    "privacy.chat": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 채팅에서는 질문과 대화 내용, 함께 보는 장소 정보, 현재 위치가 답변 생성을 위해 Google Gemini에 전송되며, 웹 검색이 필요한 질문은 Perplexity에도 전달됩니다. 답변은 AI가 생성하며 부정확할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In AI chat, your questions, the conversation, the place you are viewing, and your current location are sent to Google Gemini to generate answers. Questions that need a web search are also sent to Perplexity. Answers are AI-generated and may be inaccurate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el chat con IA, sus preguntas, la conversación, el lugar que está viendo y su ubicación actual se envían a Google Gemini para generar respuestas. Las preguntas que requieren búsqueda web también se envían a Perplexity. Las respuestas son generadas por IA y pueden ser inexactas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le chat IA, vos questions, la conversation, le lieu consulté et votre position actuelle sont envoyés à Google Gemini pour générer les réponses. Les questions nécessitant une recherche web sont aussi transmises à Perplexity. Les réponses sont générées par IA et peuvent être inexactes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella chat IA, le domande, la conversazione, il luogo visualizzato e la posizione attuale vengono inviati a Google Gemini per generare le risposte. Le domande che richiedono una ricerca web vengono inviate anche a Perplexity. Le risposte sono generate dall'IA e possono essere imprecise."
          }
        }
      }
    },
    "privacy.contact": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스와 개인정보 처리에 관한 문의는 engccer@gmail.com 으로 보내 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For questions about the service or this policy, email engccer@gmail.com."
          }
        },
        "es": {
