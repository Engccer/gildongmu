    "ios.chat.consentAlt": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동의하지 않아도 검색과 내 주변 탭은 그대로 사용할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
