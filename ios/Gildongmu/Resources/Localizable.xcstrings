    "privacy.analytics": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 방문 통계는 Vercel Analytics로 익명 집계합니다. 쿠키를 사용하지 않고, 개인을 식별하는 정보를 저장하지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web traffic is measured anonymously with Vercel Analytics. It uses no cookies and stores no information that identifies you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tráfico web se mide de forma anónima con Vercel Analytics. No utiliza cookies ni almacena información que permita identificarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audience du site est mesurée de manière anonyme avec Vercel Analytics. Aucun cookie n'est utilisé et aucune information permettant de vous identifier n'est conservée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il traffico web è misurato in forma anonima con Vercel Analytics. Non utilizza cookie e non memorizza informazioni che permettano di identificarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブの利用状況は Vercel Analytics で匿名に集計します。Cookie は使用せず、個人を特定する情報は保存しません。"
          }
        }
      }
    },
    "privacy.chat": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 채팅에서는 질문과 대화 내용, 함께 보는 장소 정보, 현재 위치가 답변 생성을 위해 Google Gemini에 전송되며, 웹 검색이 필요한 질문은 Perplexity에도 전달됩니다. 답변은 AI가 생성하며 부정확할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In AI chat, your questions, the conversation, the place you are viewing, and your current location are sent to Google Gemini to generate answers. Questions that need a web search are also sent to Perplexity. Answers are AI-generated and may be inaccurate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el chat con IA, sus preguntas, la conversación, el lugar que está viendo y su ubicación actual se envían a Google Gemini para generar respuestas. Las preguntas que requieren búsqueda web también se envían a Perplexity. Las respuestas son generadas por IA y pueden ser inexactas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le chat IA, vos questions, la conversation, le lieu consulté et votre position actuelle sont envoyés à Google Gemini pour générer les réponses. Les questions nécessitant une recherche web sont aussi transmises à Perplexity. Les réponses sont générées par IA et peuvent être inexactes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella chat IA, le domande, la conversazione, il luogo visualizzato e la posizione attuale vengono inviati a Google Gemini per generare le risposte. Le domande che richiedono una ricerca web vengono inviate anche a Perplexity. Le risposte sono generate dall'IA e possono essere imprecise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIチャットでは、質問と会話の内容、一緒に見ている場所の情報、現在地が回答生成のためにGoogle Geminiに送信され、ウェブ検索が必要な質問はPerplexityにも送信されます。回答はAIが生成するため、不正確な場合があります。"
          }
        }
      }
    },
    "privacy.contact": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스와 개인정보 처리에 관한 문의는 engccer@gmail.com 으로 보내 주세요."
          }
        },
        "en": {
          "stringUnit": {
