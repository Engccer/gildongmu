    "about.howCli": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발자: npm 패키지 gildongmu(CLI)와 gildongmu-mcp(MCP 서버)로 터미널과 AI 에이전트에서 같은 정보를 조회할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developers: the npm packages gildongmu (CLI) and gildongmu-mcp (MCP server) expose the same data to terminals and AI agents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para desarrolladores: los paquetes de npm gildongmu (CLI) y gildongmu-mcp (servidor MCP) ofrecen los mismos datos en la terminal y para agentes de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développeurs : les paquets npm gildongmu (CLI) et gildongmu-mcp (serveur MCP) donnent accès aux mêmes données dans le terminal et pour les agents IA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sviluppatori: i pacchetti npm gildongmu (CLI) e gildongmu-mcp (server MCP) offrono gli stessi dati nel terminale e per gli agenti IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発者向け: npmパッケージ gildongmu(CLI)と gildongmu-mcp(MCPサーバー)で、ターミナルやAIエージェントから同じ情報を利用できます。"
          }
        }
      }
    },
