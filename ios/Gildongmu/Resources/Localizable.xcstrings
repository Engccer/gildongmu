    "about.howWeb": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹: gildongmu.dodoplanet.space 에서 설치 없이 바로 사용합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web: use it right away at gildongmu.dodoplanet.space, no installation needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Web: úsalo directamente en gildongmu.dodoplanet.space, sin instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Web : utilisez-le directement sur gildongmu.dodoplanet.space, sans installation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
