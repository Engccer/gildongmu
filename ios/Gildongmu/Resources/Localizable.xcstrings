          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブ: gildongmu.dodoplanet.space でインストール不要ですぐに使えます。"
          }
        }
      }
    },
    "about.summary": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길동무는 대한민국 길찾기와 장소 정보 서비스입니다. 스크린 리더 사용자가 검색부터 길찾기까지 전 과정을 텍스트로 완결할 수 있도록 설계했고, 한국어·영어·스페인어·프랑스어·이탈리아어·일본어 6개 언어를 지원합니다. 웹과 iOS 앱 모두 계정 없이 무료로 사용합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gildongmu is a navigation and place information service for South Korea. It is designed so screen reader users can complete the entire flow from search to directions in text, and it supports six languages: Korean, English, Spanish, French, Italian, and Japanese. Both the web and iOS apps are free, with no account required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gildongmu es un servicio de navegación e información de lugares para Corea del Sur. Está diseñado para que quienes usan lectores de pantalla completen todo el proceso, desde la búsqueda hasta las indicaciones, en texto, y admite seis idiomas: coreano, inglés, español, francés, italiano y japonés. Tanto la web como la app de iOS son gratuitas y no requieren cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gildongmu est un service d'itinéraires et d'informations sur les lieux en Corée du Sud. Il est conçu pour que les personnes utilisant un lecteur d'écran puissent accomplir tout le parcours, de la recherche à l'itinéraire, en texte, et il prend en charge six langues : coréen, anglais, espagnol, français, italien et japonais. Le site web et l'application iOS sont gratuits, sans compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gildongmu è un servizio di navigazione e informazioni sui luoghi per la Corea del Sud. È progettato perché chi usa uno screen reader possa completare l'intero percorso, dalla ricerca alle indicazioni, in formato testo, e supporta sei lingue: coreano, inglese, spagnolo, francese, italiano e giapponese. Il sito web e l'app iOS sono gratuiti e non richiedono un account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キルドンムは韓国のナビゲーションと場所情報のサービスです。スクリーンリーダーの利用者が検索から経路案内までの全過程をテキストで完結できるように設計されており、韓国語・英語・スペイン語・フランス語・イタリア語・日本語の6言語に対応しています。ウェブとiOSアプリはどちらもアカウント不要で無料です。"
          }
        }
      }
    },
