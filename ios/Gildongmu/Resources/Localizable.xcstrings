          }
        }
      }
    },
    "privacy.dictation": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 앱의 받아쓰기는 기기 안에서 처리되어 음성이 기기를 떠나지 않습니다. 웹의 받아쓰기는 음성을 Deepgram에 전송해 텍스트로 변환하며, 변환 후 저장하지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation in the iOS app is processed on your device, so audio never leaves it. Dictation on the web sends audio to Deepgram for transcription and does not store it afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado en la app de iOS se procesa en el dispositivo, así que el audio nunca sale de él. El dictado en la web envía el audio a Deepgram para transcribirlo y no lo guarda después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée dans l'app iOS est traitée sur l'appareil : l'audio ne le quitte jamais. La dictée sur le web envoie l'audio à Deepgram pour transcription et ne le conserve pas ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura nell'app iOS viene elaborata sul dispositivo: l'audio non lo lascia mai. La dettatura sul web invia l'audio a Deepgram per la trascrizione e non lo conserva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSアプリの音声入力は端末内で処理され、音声が端末の外に出ることはありません。ウェブの音声入力は音声をDeepgramに送信してテキストに変換し、変換後は保存しません。"
          }
        }
      }
    },
    "privacy.intro": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길동무는 계정 없이 사용하는 서비스이며, 자체 데이터베이스에 개인정보를 저장하지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gildongmu works without an account and does not store personal data in any database of its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gildongmu funciona sin cuenta y no guarda datos personales en ninguna base de datos propia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gildongmu fonctionne sans compte et ne conserve aucune donnée personnelle dans une base de données propre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gildongmu funziona senza account e non conserva dati personali in alcun database proprio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キルドンムはアカウント不要で使えるサービスであり、自社データベースに個人情報を保存しません。"
          }
        }
      }
    },
    "privacy.location": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치는 주변 장소, 교통, 길찾기 정보를 실시간으로 조회하는 데에만 사용하며 저장하지 않습니다. 요청 처리 과정에서 서버 인프라의 요청 기록에 일시적으로 남을 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current location is used only to look up nearby places, transit, and directions in real time, and is not stored. It may appear temporarily in server infrastructure request logs while a request is processed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su ubicación actual se usa solo para consultar en tiempo real lugares cercanos, transporte e indicaciones, y no se guarda. Puede aparecer temporalmente en los registros de solicitudes de la infraestructura del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position actuelle sert uniquement à consulter en temps réel les lieux à proximité, les transports et les itinéraires, et n'est pas conservée. Elle peut apparaître temporairement dans les journaux de requêtes de l'infrastructure serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione attuale viene usata solo per consultare in tempo reale luoghi vicini, trasporti e indicazioni, e non viene conservata. Può comparire temporaneamente nei log delle richieste dell'infrastruttura server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地は周辺の場所・交通・経路情報をリアルタイムで照会するためだけに使用し、保存しません。リクエスト処理の過程でサーバーインフラのログに一時的に残ることがあります。"
          }
        }
      }
    },
    "privacy.search": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색어는 결과 조회를 위해 카카오, 네이버 등 검색 제공자에 전달되고, 장소와 주소 결과가 모두 없을 때는 Perplexity 웹 검색에 전달됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search terms are sent to search providers such as Kakao and Naver, and to Perplexity web search only when there are no place or address results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los términos de búsqueda se envían a proveedores como Kakao y Naver, y a la búsqueda web de Perplexity solo cuando no hay resultados de lugares ni direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les termes de recherche sont transmis à des fournisseurs comme Kakao et Naver, et à la recherche web Perplexity uniquement lorsqu'il n'y a aucun résultat de lieu ni d'adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I termini di ricerca vengono inviati a fornitori come Kakao e Naver, e alla ricerca web Perplexity solo quando non ci sono risultati di luoghi o indirizzi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索語は結果照会のためにカカオ、NAVERなどの検索プロバイダーに送信され、場所と住所の結果がどちらもない場合はPerplexityのウェブ検索に送信されます。"
          }
        }
      }
    },
