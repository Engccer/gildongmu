          "stringUnit": {
            "state": "translated",
            "value": "Las funciones basadas en la ubicación solo están disponibles dentro de Corea del Sur. La búsqueda de lugares, la información de estaciones y las indicaciones siguen disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
