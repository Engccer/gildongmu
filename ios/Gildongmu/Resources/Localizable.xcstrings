{
  "sourceLanguage": "ko",
  "strings": {
    "about.faq1a": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네. 웹과 iOS 앱 모두 무료이고 회원 가입도 없습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. Both the web and iOS apps are free, and there is no sign-up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí. La web y la app de iOS son gratuitas y no hay registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui. Le site web et l'application iOS sont gratuits, sans inscription."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sì. Il sito web e l'app iOS sono gratuiti e non c'è registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい。ウェブとiOSアプリのどちらも無料で、会員登録もありません。"
          }
        }
      }
    },
    "about.faq1q": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길동무는 무료인가요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is Gildongmu free?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Gildongmu es gratuito?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gildongmu est-il gratuit ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gildongmu è gratuito?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キルドンムは無料ですか?"
          }
        }
      }
    },
    "about.faq2a": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네, 그것이 길동무의 출발점입니다. 모든 정보가 텍스트로 제공되어 VoiceOver 같은 스크린 리더만으로 검색, 장소 정보, 길찾기 전 과정을 쓸 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, that is what Gildongmu is built around. All information is provided as text, so the entire flow of search, place details, and directions works with a screen reader such as VoiceOver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, ese es el punto de partida de Gildongmu. Toda la información se ofrece como texto, así que la búsqueda, los detalles de lugares y las indicaciones funcionan con lectores de pantalla como VoiceOver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, c'est le point de départ de Gildongmu. Toutes les informations sont fournies en texte : la recherche, les détails des lieux et les itinéraires fonctionnent avec un lecteur d'écran comme VoiceOver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sì, è questo il punto di partenza di Gildongmu. Tutte le informazioni sono in formato testo: ricerca, dettagli dei luoghi e indicazioni funzionano con screen reader come VoiceOver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい、それがキルドンムの出発点です。すべての情報がテキストで提供されるため、VoiceOverなどのスクリーンリーダーだけで検索、場所の情報、経路案内の全過程を利用できます。"
          }
        }
      }
    },
    "about.faq2q": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시각장애인이 스크린 리더로 쓸 수 있나요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can blind users use it with a screen reader?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Pueden usarlo personas ciegas con un lector de pantalla?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes aveugles peuvent-elles l'utiliser avec un lecteur d'écran ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le persone cieche possono usarlo con uno screen reader?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視覚障害者がスクリーンリーダーで使えますか?"
          }
        }
      }
    },
    "about.faq3a": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네. 영어를 포함한 6개 언어 화면을 제공하고, 장소 정보는 한국어와 영어로 제공됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. The interface is available in six languages including English, and place data is available in Korean and English."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí. La interfaz está disponible en seis idiomas, incluido el español, y los datos de lugares están en coreano e inglés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui. L'interface est disponible en six langues, dont le français, et les données de lieux sont en coréen et en anglais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sì. L'interfaccia è disponibile in sei lingue, incluso l'italiano, e i dati sui luoghi sono in coreano e in inglese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい。日本語を含む6言語の画面を提供しており、場所のデータは韓国語と英語で提供されます。"
          }
        }
      }
    },
    "about.faq3q": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한국어를 몰라도 쓸 수 있나요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I use it without knowing Korean?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Puedo usarlo sin saber coreano?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis-je l'utiliser sans parler coréen ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso usarlo senza conoscere il coreano?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "韓国語が分からなくても使えますか?"
          }
        }
      }
    },
    "about.faq4a": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소 검색, 역 정보, 목적지 길찾기처럼 이름으로 조회하는 기능은 전 세계 어디서나 동작합니다. 현재 위치 기반 기능은 대한민국 안에서만 동작합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Features that look things up by name, such as place search, station information, and directions to a destination, work anywhere in the world. Features based on your current location work only within South Korea."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones que consultan por nombre, como la búsqueda de lugares, la información de estaciones y las indicaciones a un destino, funcionan en todo el mundo. Las funciones basadas en tu ubicación actual solo funcionan dentro de Corea del Sur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctions qui consultent par nom, comme la recherche de lieux, les informations sur les stations et les itinéraires vers une destination, fonctionnent partout dans le monde. Les fonctions basées sur votre position actuelle ne fonctionnent qu'en Corée du Sud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le funzioni che cercano per nome, come la ricerca di luoghi, le informazioni sulle stazioni e le indicazioni verso una destinazione, funzionano in tutto il mondo. Le funzioni basate sulla posizione attuale funzionano solo in Corea del Sud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所検索、駅情報、目的地への経路案内のように名前で調べる機能は世界中どこでも使えます。現在地に基づく機能は韓国国内でのみ動作します。"
          }
        }
      }
    },
    "about.faq4q": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한국 밖에서도 쓸 수 있나요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does it work outside South Korea?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Funciona fuera de Corea del Sur?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne-t-il en dehors de la Corée du Sud ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona fuori dalla Corea del Sud?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "韓国の外でも使えますか?"
          }
        }
      }
    },
    "about.faq5a": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도는 스크린 리더로 읽을 수 없어서 길동무는 모든 정보를 텍스트로 제공합니다. 실제 주행 안내가 필요하면 네이버 지도나 카카오맵 앱으로 연결합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maps cannot be read by screen readers, so Gildongmu presents everything as text. For turn-by-turn driving it hands off to the Naver Map or KakaoMap apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mapas no pueden leerse con lectores de pantalla, así que Gildongmu presenta toda la información como texto. Para la conducción con guía en tiempo real te deriva a las apps Naver Map o KakaoMap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes ne peuvent pas être lues par un lecteur d'écran, donc Gildongmu présente tout en texte. Pour le guidage routier réel, vous êtes redirigé vers les applications Naver Map ou KakaoMap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mappe non possono essere lette dagli screen reader, quindi Gildongmu presenta tutto come testo. Per la guida su strada vera e propria si passa alle app Naver Map o KakaoMap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図はスクリーンリーダーで読めないため、キルドンムはすべての情報をテキストで提供します。実際の走行案内が必要な場合はNAVERマップやカカオマップのアプリに引き継ぎます。"
          }
        }
      }
    },
    "about.faq5q": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도 화면이 없는 이유가 있나요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why is there no map view?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué no hay mapa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi n'y a-t-il pas de carte ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché non c'è una mappa?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図画面がないのはなぜですか?"
          }
        }
      }
    },
    "about.faqHeading": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 묻는 질문"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequently asked questions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntas frecuentes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions fréquentes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Domande frequenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よくある質問"
          }
        }
      }
    },
    "about.feature1": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소·주소 검색: 상호명, 도로명주소, 우편번호로 전국의 장소를 찾습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place and address search: find places across Korea by name, street address, or postal code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Búsqueda de lugares y direcciones: encuentra lugares de toda Corea por nombre, dirección o código postal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de lieux et d'adresses : trouvez des lieux dans toute la Corée par nom, adresse ou code postal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricerca di luoghi e indirizzi: trova luoghi in tutta la Corea per nome, indirizzo o codice postale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所・住所検索: 店舗名、道路名住所、郵便番号で韓国全国の場所を探せます。"
          }
        }
      }
    },
    "about.feature2": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길찾기 미리 듣기: 자동차, 대중교통, 도보 경로를 출발 전에 텍스트 브리핑으로 확인합니다. 도보는 계단 없는 경로 옵션이 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Route preview: get a text briefing of car, transit, and walking routes before you leave. Walking routes offer a stair-free option."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa de rutas: recibe un resumen en texto de las rutas en coche, transporte público y a pie antes de salir. Las rutas a pie ofrecen una opción sin escaleras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu d'itinéraire : recevez un résumé textuel des trajets en voiture, en transports en commun et à pied avant de partir. Les trajets à pied proposent une option sans escaliers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima del percorso: ricevi un riepilogo testuale dei percorsi in auto, con i mezzi pubblici e a piedi prima di partire. I percorsi a piedi offrono un'opzione senza scale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経路の事前ブリーフィング: 車、公共交通、徒歩の経路を出発前にテキストで確認できます。徒歩には階段を避ける経路のオプションがあります。"
          }
        }
      }
    },
    "about.feature3": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 주변 정보: 지하철 실시간 도착, 버스, 소아 야간진료, 무장애 관광지, 음향신호기 같은 보행 인프라를 현재 위치 기준으로 조회합니다. 따릉이, 문화행사, 혼잡도 등 일부 정보는 서울에서 제공됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby information: real-time subway arrivals, buses, late-night pediatric clinics, barrier-free tourist sites, and pedestrian infrastructure such as audible signals, based on your current location. Some data, including bike share, cultural events, and crowd levels, covers Seoul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Información cercana: llegadas de metro en tiempo real, autobuses, clínicas pediátricas nocturnas, sitios turísticos accesibles e infraestructura peatonal como señales sonoras, según tu ubicación actual. Algunos datos, como bicicletas compartidas, eventos culturales y niveles de afluencia, cubren Seúl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Informations à proximité : arrivées de métro en temps réel, bus, cliniques pédiatriques de nuit, sites touristiques accessibles et infrastructures piétonnes comme les signaux sonores, selon votre position actuelle. Certaines données, comme les vélos en libre-service, les événements culturels et l'affluence, couvrent Séoul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informazioni nei dintorni: arrivi della metropolitana in tempo reale, autobus, cliniche pediatriche notturne, siti turistici accessibili e infrastrutture pedonali come i segnali acustici, in base alla tua posizione attuale. Alcuni dati, come bike sharing, eventi culturali e livelli di affollamento, riguardano Seul."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周辺情報: 地下鉄のリアルタイム到着、バス、小児夜間診療、バリアフリー観光地、音響信号機などの歩行インフラを現在地基準で調べられます。シェア自転車、文化イベント、混雑度など一部の情報はソウルで提供されます。"
          }
        }
      }
    },
    "about.feature4": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "역 정보: 전국 지하철역의 시설, 첫차와 막차 시간표, 엘리베이터 위치를 확인합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Station information: facilities, first and last train times, and elevator locations for subway stations nationwide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Información de estaciones: instalaciones, horarios del primer y último tren y ubicación de ascensores de las estaciones de metro de todo el país."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Informations sur les stations : équipements, horaires des premiers et derniers trains et emplacement des ascenseurs des stations de métro de tout le pays."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informazioni sulle stazioni: strutture, orari del primo e dell'ultimo treno e posizione degli ascensori delle stazioni della metropolitana di tutto il Paese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駅情報: 全国の地下鉄駅の設備、始発・終電の時刻、エレベーターの位置を確認できます。"
          }
        }
      }
    },
    "about.feature5": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 채팅: 장소에 관해 질문하면 실시간 데이터를 조회해 답합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI chat: ask about a place and get answers grounded in live data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat con IA: pregunta sobre un lugar y recibe respuestas basadas en datos en tiempo real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat IA : posez une question sur un lieu et obtenez des réponses fondées sur des données en temps réel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat IA: fai una domanda su un luogo e ricevi risposte basate su dati in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIチャット: 場所について質問すると、リアルタイムのデータを参照して答えます。"
          }
        }
      }
    },
    "about.featuresHeading": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
