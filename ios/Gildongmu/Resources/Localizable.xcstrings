    "ios.chat.consentAiNotice": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변은 AI가 생성하며 부정확할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers are AI-generated and may be inaccurate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas son generadas por IA y pueden ser inexactas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses sont générées par IA et peuvent être inexactes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte sono generate dall'IA e possono essere imprecise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答はAIが生成するため、不正確な場合があります。"
          }
        }
      }
    },
    "ios.chat.consentAlt": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동의하지 않아도 검색과 내 주변 탭은 그대로 사용할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can keep using the Search and Nearby tabs without agreeing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede seguir usando las pestañas Buscar y Cerca sin aceptar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez continuer à utiliser les onglets Recherche et À proximité sans accepter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi continuare a usare le schede Cerca e Nelle vicinanze senza accettare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同意しなくても、検索と周辺タブはそのまま利用できます。"
          }
        }
      }
    },
    "ios.chat.consentData": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문과 대화 내용, 함께 보는 장소 정보, 현재 위치가 답변 생성을 위해 Google Gemini로 전송됩니다. 웹 검색이 필요한 질문은 Perplexity에도 전달됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your questions, the conversation, the place you are viewing, and your current location are sent to Google Gemini to generate answers. Questions that need a web search are also sent to Perplexity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus preguntas, la conversación, el lugar que está viendo y su ubicación actual se envían a Google Gemini para generar respuestas. Las preguntas que requieren búsqueda web también se envían a Perplexity."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos questions, la conversation, le lieu consulté et votre position actuelle sont envoyés à Google Gemini pour générer les réponses. Les questions nécessitant une recherche web sont aussi transmises à Perplexity."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le domande, la conversazione, il luogo visualizzato e la posizione attuale vengono inviati a Google Gemini per generare le risposte. Le domande che richiedono una ricerca web vengono inviate anche a Perplexity."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問と会話の内容、一緒に見ている場所の情報、現在地が回答生成のためにGoogle Geminiに送信されます。ウェブ検索が必要な質問はPerplexityにも送信されます。"
          }
        }
      }
    },
