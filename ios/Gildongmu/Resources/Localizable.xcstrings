    "ios.voice.holdGuide": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누른 채로 말해 주세요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold to speak"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado para hablar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez appuyé pour parler"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto per parlare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したまま話してください"
          }
        }
      }
    },
    "ios.voice.holdHintChat": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누른 채로 말하고, 손을 떼면 전송합니다. 누른 채 위로 밀면 잠겨서 그때까지 받아쓴 내용이 입력창에 들어가고, 수정한 뒤 다시 길게 눌러 이어서 받아쓸 수 있습니다. 누른 채 왼쪽으로 밀면 취소합니다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold to speak; release to send. Slide up while holding to lock: what you said so far goes into the text field, where you can edit it, then press and hold again to continue dictating. Slide left while holding to cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado para hablar y suelta para enviar. Desliza hacia arriba sin soltar para bloquear: lo dictado hasta entonces pasa al campo de texto, donde puedes editarlo, y mantén pulsado de nuevo para seguir dictando. Desliza hacia la izquierda sin soltar para cancelar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez appuyé pour parler, relâchez pour envoyer. Faites glisser vers le haut sans relâcher pour verrouiller : ce qui a été dicté passe dans le champ de texte, où vous pouvez le modifier, puis maintenez appuyé de nouveau pour continuer la dictée. Faites glisser vers la gauche sans relâcher pour annuler"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto per parlare, rilascia per inviare. Scorri verso l'alto senza rilasciare per bloccare: quanto dettato finora entra nel campo di testo, dove puoi modificarlo, poi tieni premuto di nuovo per continuare a dettare. Scorri verso sinistra senza rilasciare per annullare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押している間話し、指を離すと送信します。押したまま上にスライドするとロックされ、それまでの内容が入力欄に入り、編集してからもう一度長押しすると続けて入力できます。押したまま左にスライドするとキャンセルします"
          }
        }
      }
    },
    "ios.voice.holdHintSearch": {
