# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
packages/*/dist/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ⚠ 예외: 키 없는 예시 파일은 반드시 커밋한다.
#    create-next-app 기본 .gitignore가 `.env*`만 두는 바람에 .env.example이
#    한 번도 커밋되지 않았고(2026-08-08 발견), README가 "복사해서 쓰라"고
#    안내하는 파일이 새 클론에는 존재하지 않았다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python 캐시
__pycache__/

# 모델 A/B 실호출 원시 결과(로컬 전용)
.ab-out/

# 실기기 계측 로그 원본(초 단위 위경도 = 개발자 이동 경로). repo 밖 보관, 색인만 logs/README.md에.
docs/superpowers/specs/logs/*.log
docs/superpowers/specs/logs/*.log.gz

# 착수 판정용 내부 조사 메모(후보 대조·타 repo 사정 등 제품과 무관한 심의 기록).
# repo 밖 ~/gildongmu-private/research/ 보관. 코드를 구속하는 결론만 BACKLOG·CLAUDE.md로 옮긴다.
docs/research/RESEARCH-*-webmcp-challenge.md
docs/research/_internal/

# Android CLI가 설치하는 에이전트 스킬(구글 android/skills 사본). 커밋하지 않고 worktree마다 `android skills add <id> --project=.`로 받는다(android/README.md §2)
.claude/skills/

# 실기기 계측 로그(iOS guide-diag*·안드로이드 동형)는 커밋하지 않는다 — 원본은 ~/gildongmu-private/field-logs/
guide-diag*.log*
