# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
packages/*/dist/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ⚠ 예외: 키 없는 예시 파일은 반드시 커밋한다.
#    create-next-app 기본 .gitignore가 `.env*`만 두는 바람에 .env.example이
#    한 번도 커밋되지 않았고(2026-08-08 발견), README가 "복사해서 쓰라"고
#    안내하는 파일이 새 클론에는 존재하지 않았다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python 캐시
__pycache__/

# 모델 A/B 실호출 원시 결과(로컬 전용)
.ab-out/
